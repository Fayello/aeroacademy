generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  passwordHash             String?
  googleId                 String?                   @unique
  role                     Role                      @default(STUDENT)
  userExperience           String                    @default("INDIVIDUAL") // INDIVIDUAL, UNIVERSITY, CORPORATE, INSTRUCTOR, ADMIN
  emailVerified            DateTime?
  verificationToken        String?                   @unique
  createdAt                DateTime                  @default(now())
  username                 String?                   @unique
  avatarUrl                String?
  pinnedBadges             Json                      @default("[]")
  bio                      String?
  name                     String?
  city                     String?                   @default("Yaoundé")
  organizationId           String?
  organization             Organization?             @relation(fields: [organizationId], references: [id])
  xp                       Int                       @default(0)
  rank                     Int                       @default(0)
  division                 String                    @default("BRONZE")
  clearanceLevel           Int                       @default(1)
  currentStreak            Int                       @default(0)
  longestStreak            Int                       @default(0)
  lastActivityDate         DateTime?
  streakFreezes            Int                       @default(0)
  lastStreakFreezeUsedAt   DateTime?
  dailyMissionCombo        Int                       @default(0)
  lastDailyComboDate       DateTime?
  welcomeDripSent          Json                      @default("[]")
  lastEmailSentAt          DateTime?
  emailPreferences         Json                      @default("{\"milestones\":true,\"weeklyDigest\":true,\"nudges\":true,\"reengagement\":true,\"achievements\":true,\"courseUpdates\":true,\"streaks\":true,\"labCompletions\":true}")
  timezone                 String?                   @default("UTC")
  referralCode             String?                   @unique
  referredBy               String?
  teamId                   String?
  team                     Team?                     @relation(fields: [teamId], references: [id])
  bossAttempts             BossMissionAttempt[]
  globalEventParticipation GlobalEventParticipant[]
  crossDomainProgress      CrossDomainProgress[]
  ownedTeams               Team[]                    @relation("TeamOwner")
  labInstances             LabInstance[]
  labSubmissions           LabSubmission[]
  progress                 Progress[]
  quizSubmissions          QuizSubmission[]
  achievements             UserAchievement[]
  shortlistedBy            Shortlist[]               @relation("StudentShortlisted")
  shortlistedUsers         Shortlist[]               @relation("RecruiterShortlist")
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  masterClassRegistrations MasterClassRegistration[]
  trainer                  Trainer?
  bookings                 Booking[]
  activityEvents           ActivityEvent[]
  auditLogs                AuditLog[]
  notifications            Notification[]
  enrollments              CourseEnrollment[]
  badges                   UserBadge[]
  userSkills               UserSkill[]
  userChallenges           UserChallenge[]
  progressionEvents        ProgressionEvent[]
  assessmentResults        AssessmentResult[]
  reviews                  CourseReview[]
  learningPathEnrollments  LearningPathEnrollment[]
  discussionPosts          DiscussionPost[]
  discussionComments       DiscussionComment[]
  discussionVotes          DiscussionVote[]
  preference               UserPreference?
  domainRanks              DomainRank[]
  rankSnapshots            SeasonRankSnapshot[]
  globalRankSnapshots      GlobalRankSnapshot[]
  placementMatches         PlacementMatch[]
  ratingEvents             DomainRatingEvent[]
  masteryEvents            SkillMasteryEvent[]
  personalizedMissions     PersonalizedMission[]
  outcomeEvidence          OutcomeEvidence[]
  cohortMemberships        CohortMember[]
  studentAssessments       StudentAssessment[]
  certificationAwards      CertificationAward[]
  professionalRecord       ProfessionalRecord?
  metricEvents             MetricEvent[]
  teamMembers              TeamMember[]
  gradeEntries             GradeEntry[]
  studentGPA               StudentGPA?
  tutoringInteractions     TutoringInteraction[]

  @@index([googleId])
  @@index([role])
  @@index([xp])
}

model Team {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  inviteCode  String?  @unique
  visibility  String   @default("PUBLIC") // PUBLIC, PRIVATE
  maxMembers  Int      @default(20)
  ownerId     String
  owner       User?    @relation("TeamOwner", fields: [ownerId], references: [id])
  members     User[]
  createdAt   DateTime @default(now())
  courseEnrollments TeamCourseEnrollment[]
  teamMembers TeamMember[]

  // Team customization
  avatarUrl      String?
  bannerUrl      String?
  primaryColor   String?  @default("#229C62")
  accentColor    String?  @default("#7AD62A")
  motto          String?
  tagline        String?

  @@index([ownerId])
  @@index([inviteCode])
}

model Season {
  id                   String   @id @default(uuid())
  name                 String
  theme                String?
  domainTheme          String?
  seasonNumber         Int      @default(1)
  xpMultiplier         Float    @default(1.0)
  startDate            DateTime
  endDate              DateTime
  isActive             Boolean  @default(false)
  softResetCompleted   Boolean  @default(false)
  createdAt            DateTime @default(now())

  battlePass    BattlePass?
  bossMissions  BossMission[]
  globalEvents  GlobalEvent[]
  snapshots     LeaderboardSnapshot[]
  domainRanks   DomainRank[]
  rankSnapshots SeasonRankSnapshot[]
  globalRankSnapshots GlobalRankSnapshot[]
  placementMatches PlacementMatch[]
  ratingEvents  DomainRatingEvent[]
}

model Organization {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String   @default("UNIVERSITY") // UNIVERSITY, ENTERPRISE, GOVERNMENT
  location  String
  users     User[]
  createdAt DateTime @default(now())
}

model Course {
  id             String               @id @default(uuid())
  title          String
  description    String
  imageUrl       String?
  estimatedHours Int?
  createdAt      DateTime             @default(now())
  sections       Section[]
  enrollments    CourseEnrollment[]
  reviews        CourseReview[]
  learningPaths  LearningPathCourse[]
  discussions    DiscussionPost[]
  teamEnrollments TeamCourseEnrollment[]
  moduleCourses  ModuleCourse[]
  cohortAssignments CohortCourseAssignment[]
}

model Section {
  id       String   @id @default(uuid())
  courseId String
  title    String
  order    Int      @default(0)
  lessons  Lesson[]
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Lesson {
  id        String     @id @default(uuid())
  sectionId String
  title     String
  order     Int        @default(0)
  videoUrl  String?
  content   String?
  labId     String?    @unique
  lab       Lab?       @relation(fields: [labId], references: [id], onDelete: SetNull)
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  progress  Progress[]
  quiz      Quiz?
}

model Quiz {
  id          String           @id @default(uuid())
  lessonId    String           @unique
  questions   Question[]
  lesson      Lesson           @relation(fields: [lessonId], references: [id])
  submissions QuizSubmission[]
}

model QuizSubmission {
  id        String   @id @default(uuid())
  quizId    String
  userId    String
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())
  quiz      Quiz     @relation(fields: [quizId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, quizId])
}

model Question {
  id      String   @id @default(uuid())
  quizId  String
  text    String
  answers Answer[]
  quiz    Quiz     @relation(fields: [quizId], references: [id])
}

model Answer {
  id         String   @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean
  question   Question @relation(fields: [questionId], references: [id])
}

model Lab {
  id               String        @id @default(uuid())
  title            String
  description      String
  dockerImage      String
  briefing         String?
  credentials      Json?
  tasks            Json?
  basePath         String?       @default("")
  imageUrl         String?
  difficulty       Int           @default(1200)
  estimatedMinutes Int?          @default(60)
  flags            LabFlag[]
  instances        LabInstance[]
  lesson           Lesson?
  discussions     DiscussionPost[]
  labSkills        LabSkill[]
  labOutcomes      LabOutcome[]
  moduleLabs       ModuleLab[]
  analytics        LabAnalytics?
}

model LabFlag {
  id            String          @id @default(uuid())
  labId         String
  title         String
  description   String?
  points        Int             @default(100)
  correctAnswer String
  lab           Lab             @relation(fields: [labId], references: [id])
  submissions   LabSubmission[]

  @@index([labId])
}

model LabSubmission {
  id        String   @id @default(uuid())
  flagId    String
  userId    String
  answer    String
  isCorrect Boolean
  createdAt DateTime @default(now())
  flag      LabFlag  @relation(fields: [flagId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, flagId])
}

model Progress {
  userId    String
  lessonId  String
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, lessonId])
  @@index([userId, updatedAt])
}

model LabInstance {
  id          String    @id @default(uuid())
  userId      String
  labId       String
  containerId String?
  serverId    String    @default("local")
  port        Int?
  status      LabStatus @default(RUNNING)
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  lab         Lab       @relation(fields: [labId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

model Achievement {
  id              String            @id @default(uuid())
  title           String            @unique
  description     String
  icon            String
  category        String            // MILESTONE, MASTERY, STREAK, SOCIAL, CHALLENGE
  xpReward        Int               @default(0)
  rarity          String            @default("COMMON") // COMMON, UNCOMMON, RARE, EPIC, LEGENDARY
  requirementType String            // FLAGS_CAPTURED, LABS_COMPLETED, STREAK_DAYS, LEVEL_REACHED, etc.
  requirementTarget Int             @default(1)
  chainParentId   String?
  chainOrder      Int               @default(0)
  isActive        Boolean           @default(true)
  users           UserAchievement[]

  chainParent Achievement? @relation("AchievementChain", fields: [chainParentId], references: [id])
  chainChildren Achievement[] @relation("AchievementChain")
}

model UserAchievement {
  userId        String
  achievementId String
  unlockedAt    DateTime    @default(now())
  progress      Int         @default(0)
  target        Int         @default(1)
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@id([userId, achievementId])
}

model Shortlist {
  id          String   @id @default(uuid())
  recruiterId String
  studentId   String
  notes       String?
  createdAt   DateTime @default(now())

  recruiter User @relation("RecruiterShortlist", fields: [recruiterId], references: [id])
  student   User @relation("StudentShortlisted", fields: [studentId], references: [id])

  @@unique([recruiterId, studentId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  code      String
  purpose   String   @default("email_verification")
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([code])
}

model MasterClass {
  id               String                    @id @default(uuid())
  title            String
  description      String
  instructorName   String?
  instructorBio    String?
  instructorAvatar String?
  thumbnailUrl     String?
  category         String                    @default("SECURITY")
  scheduledAt      DateTime?
  duration         Int                       @default(60)
  maxParticipants  Int?
  isLive           Boolean                   @default(true)
  recordingUrl     String?
  status           MasterClassStatus         @default(UPCOMING)
  createdAt        DateTime                  @default(now())
  registrations    MasterClassRegistration[]
}

model MasterClassRegistration {
  id            String      @id @default(uuid())
  masterClassId String
  userId        String
  registeredAt  DateTime    @default(now())
  masterClass   MasterClass @relation(fields: [masterClassId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([masterClassId, userId])
  @@index([userId])
}

model Trainer {
  id          String         @id @default(uuid())
  userId      String         @unique
  bio         String?
  specialties String[]
  hourlyRate  Int?
  isActive    Boolean        @default(true)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  slots       TrainingSlot[]
  bookings    Booking[]

  @@index([userId])
}

model TrainingSlot {
  id        String  @id @default(uuid())
  trainerId String
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean @default(true)
  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@index([trainerId, dayOfWeek, isActive])
}

model Booking {
  id        String        @id @default(uuid())
  trainerId String
  studentId String
  slotId    String?
  date      DateTime
  startTime String
  endTime   String
  topic     String
  status    BookingStatus @default(PENDING)
  notes     String?
  createdAt DateTime      @default(now())
  trainer   Trainer       @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  student   User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([trainerId])
  @@index([trainerId, date])
}

enum MasterClassStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum Role {
  STUDENT
  PROFESSOR
  TA
  ADMIN
  RECRUITER
}

enum LabStatus {
  RUNNING
  STOPPED
  EXPIRED
  PROVISIONING
}

model ActivityEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String // LAB_STARTED, LAB_STOPPED, FLAG_SOLVED, LESSON_COMPLETED, QUIZ_PASSED, COURSE_COMPLETED
  metadata  Json? // { labId, labTitle, flagTitle, lessonId, courseId, etc. }
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String // AUTH_LOGIN, COURSE_CREATED, LAB_STARTED, BOOKING_CREATED, etc.
  actorId    String? // null for unauthenticated actions (failed login, etc.)
  actorEmail String?
  method     String
  path       String
  statusCode Int
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorId])
  @@index([createdAt])
  @@index([statusCode])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ACHIEVEMENT, BOOKING, MASTERCLASS
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model CourseEnrollment {
  userId           String
  courseId         String
  enrolledAt      DateTime @default(now())
  lastActivityAt  DateTime @default(now())
  lastReminderSentAt DateTime?
  milestonesSent  Json     @default("[]")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([lastActivityAt])
}

model CourseReview {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@index([rating])
}

model LearningPath {
  id              String              @id @default(uuid())
  title           String
  description     String
  imageUrl        String?
  difficulty      String              @default("BEGINNER")
  prerequisitePathId String?
  careerRole      String?             // "SOC Analyst", "DevOps Engineer", etc.
  certificationName String?
  estimatedHours  Int?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  courses         LearningPathCourse[]
  enrollments     LearningPathEnrollment[]

  prerequisitePath LearningPath? @relation("PathPrerequisite", fields: [prerequisitePathId], references: [id])
  prerequisiteFor  LearningPath[] @relation("PathPrerequisite")
}

model LearningPathCourse {
  id             String         @id @default(uuid())
  learningPathId String
  courseId        String
  order          Int            @default(0)
  learningPath   LearningPath   @relation(fields: [learningPathId], references: [id], onDelete: Cascade)
  course         Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([learningPathId, courseId])
  @@index([learningPathId])
  @@index([courseId])
}

model LearningPathEnrollment {
  id             String      @id @default(uuid())
  userId         String
  learningPathId String
  enrolledAt     DateTime    @default(now())
  completedAt    DateTime?
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  learningPath   LearningPath @relation(fields: [learningPathId], references: [id], onDelete: Cascade)

  @@unique([userId, learningPathId])
  @@index([userId])
  @@index([learningPathId])
}

model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  icon        String
  category    String      @default("SKILL") // SKILL, MILESTONE, SPECIAL
  tier        String      @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  xpReward    Int         @default(0)
  requirement String      // e.g. "complete_linux_basics", "capture_10_flags"
  users       UserBadge[]
}

model UserBadge {
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@id([userId, badgeId])
  @@index([userId])
}

model SkillAssessment {
  id          String   @id @default(uuid())
  title       String
  description String
  category    String   // LINUX, NETWORKING, WEB_SECURITY, CRYPTO
  questions   Json     // Array of assessment questions
  createdAt   DateTime @default(now())
  results     AssessmentResult[]
}

model AssessmentResult {
  id           String          @id @default(uuid())
  assessmentId String
  userId       String
  score        Int
  maxScore     Int
  answers      Json
  recommendedPath Json?       // Recommended courses based on score
  createdAt    DateTime       @default(now())
  assessment   SkillAssessment @relation(fields: [assessmentId], references: [id])
  user         User            @relation(fields: [userId], references: [id])

  @@unique([assessmentId, userId])
  @@index([userId])
}

model DiscussionPost {
  id           String              @id @default(uuid())
  courseId     String?
  labId        String?
  userId       String
  title        String
  body         String
  isPinned     Boolean             @default(false)
  isResolved   Boolean             @default(false)
  tags         String[]            @default([])
  upvotes      Int                 @default(0)
  commentCount Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  course       Course?             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lab          Lab?                @relation(fields: [labId], references: [id], onDelete: Cascade)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments     DiscussionComment[]
  votes        DiscussionVote[]

  @@index([courseId, createdAt])
  @@index([courseId, isPinned])
  @@index([labId, createdAt])
  @@index([labId, isPinned])
  @@index([userId])
}

model DiscussionComment {
  id        String           @id @default(uuid())
  postId    String
  userId    String
  body      String
  parentId  String?
  upvotes   Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  post      DiscussionPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    DiscussionComment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   DiscussionComment[] @relation("CommentReplies")
  votes     DiscussionVote[]

  @@index([postId, createdAt])
  @@index([userId])
}

model DiscussionVote {
  id        String           @id @default(uuid())
  userId    String
  postId    String?
  commentId String?
  value     Int              @default(1) // 1 = upvote, -1 = downvote
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      DiscussionPost?  @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   DiscussionComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
}

model CourseReorderHistory {
  id        String   @id @default(uuid())
  courseId   String
  entityType String  // SECTION, LESSON
  entityId   String
  oldOrder   Int
  newOrder   Int
  actorId    String
  createdAt  DateTime @default(now())

  @@index([courseId])
}

model TeamCourseEnrollment {
  id        String   @id @default(uuid())
  teamId    String
  courseId  String
  enrolledAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([teamId, courseId])
  @@index([teamId])
  @@index([courseId])
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     String   @default("MEMBER") // LEADER, MEMBER
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

// ─── V1: SKILL SYSTEM ───────────────────────────────────────────

model SkillDomain {
  id          String   @id @default(uuid())
  name        String   @unique // SYSTEMS, NETWORKING, DEVOPS, DATABASES, SECURITY, QA
  displayName String   // "Systems", "Networking", etc.
  icon        String?  // lucide icon name
  createdAt   DateTime @default(now())

  skills                Skill[]
  challenges            Challenge[]
  domainRanks           DomainRank[]
  personalizedMissions  PersonalizedMission[]
  learningOutcomes      LearningOutcome[]
  practicalAssessments  PracticalAssessment[]
}

model Skill {
  id          String   @id @default(uuid())
  domainId    String
  name        String   // "Linux", "Docker", "SQL", etc.
  displayName String
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  domain         SkillDomain           @relation(fields: [domainId], references: [id])
  userSkills     UserSkill[]
  labSkills      LabSkill[]
  challenges     Challenge[]
  masteryEvents  SkillMasteryEvent[]
  prerequisites  SkillPrerequisite[]   @relation("SkillRequires")
  requiredBy     SkillPrerequisite[]   @relation("SkillNeeded")
  personalizedMissions PersonalizedMission[]
  skillOutcomes  SkillOutcome[]

  @@unique([domainId, name])
  @@index([domainId])
}

model UserSkill {
  id              String    @id @default(uuid())
  userId          String
  skillId         String
  xp              Int       @default(0)
  level           Int       @default(1)
  mastery         Float     @default(0)     // 0-100, demonstrated ability
  lastPracticedAt DateTime?                 // last time skill was demonstrated
  decayRate       Float     @default(0.5)   // % mastery lost per day of inactivity
  isDecaying      Boolean   @default(false)  // whether decay is currently active
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@index([lastPracticedAt])
}

model LabSkill {
  id      String @id @default(uuid())
  labId   String
  skillId String

  lab   Lab   @relation(fields: [labId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([labId, skillId])
  @@index([labId])
  @@index([skillId])
}

// ─── V4: TECHNOLOGY GENOME ──────────────────────────────────────

model SkillMasteryEvent {
  id            String   @id @default(uuid())
  userId        String
  skillId       String
  eventType     String   // MASTERY_GAIN, MASTERY_DECAY, MASTERY_RECOVERY, MASTERY_SET
  amount        Float    // change in mastery percentage
  masteryBefore Float
  masteryAfter  Float
  source        String   // FLAG_SOLVED, LAB_COMPLETED, DECAY_CRON, RECOVERY_MISSION
  sourceId      String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@index([userId, skillId])
  @@index([createdAt])
  @@index([eventType])
}

model SkillPrerequisite {
  id             String @id @default(uuid())
  skillId        String
  prerequisiteId String
  minMastery     Float  @default(50) // required mastery of prerequisite

  skill        Skill @relation("SkillRequires", fields: [skillId], references: [id])
  prerequisite Skill @relation("SkillNeeded", fields: [prerequisiteId], references: [id])

  @@unique([skillId, prerequisiteId])
}

model PersonalizedMission {
  id               String   @id @default(uuid())
  userId           String
  title            String
  description      String
  difficulty       Int      // 1-10
  estimatedMinutes Int
  targetSkillId    String?
  targetDomainId   String?
  xpReward         Int
  masteryReward    Float    // mastery boost on completion
  missionType      String   // SKILL_MAINTENANCE, WEAKNESS_IMPROVEMENT, CROSS_DOMAIN, RANKED
  status           String   @default("AVAILABLE") // AVAILABLE, ACTIVE, COMPLETED, EXPIRED
  expiresAt        DateTime?
  completedAt      DateTime?
  metadata         Json?
  createdAt        DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id])
  skill  Skill?        @relation(fields: [targetSkillId], references: [id])
  domain SkillDomain?  @relation(fields: [targetDomainId], references: [id])

  @@index([userId, status])
  @@index([userId, createdAt])
}

// ─── V1: MISSION ENGINE ─────────────────────────────────────────

model Challenge {
  id              String   @id @default(uuid())
  type            String   // DAILY_WARMUP, DAILY_SKILL, DAILY_BOSS, WEEKLY, MONTHLY, TEAM_WEEKLY
  domainId        String?
  skillId         String?
  title           String
  description     String
  difficulty      String   // EASY, MEDIUM, HARD, BOSS
  objectiveType   String   // FLAG_COMPLETIONS, LAB_COMPLETIONS, LESSON_COMPLETIONS, QUIZ_COMPLETIONS, XP_EARNED, SKILL_XP_EARNED
  objectiveTarget Int
  xpReward        Int
  badgeRewardId   String?
  startAt         DateTime
  endAt           DateTime
  isActive        Boolean  @default(true)
  metadata        Json?
  createdAt       DateTime @default(now())

  domain      SkillDomain?  @relation(fields: [domainId], references: [id])
  skill       Skill?         @relation(fields: [skillId], references: [id])
  userChallenges UserChallenge[]

  @@index([type, isActive])
  @@index([startAt, endAt])
  @@index([domainId])
}

model UserChallenge {
  id          String    @id @default(uuid())
  userId      String
  challengeId String
  progress    Int       @default(0)
  target      Int
  completed   Boolean   @default(false)
  completedAt DateTime?
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@index([userId, completed])
}

// ─── V1: FEATURE UNLOCKING ──────────────────────────────────────

model FeatureUnlock {
  id            String @id @default(uuid())
  feature       String @unique // DAILY_MISSIONS, SKILL_PROFILE, LEADERBOARD, etc.
  requiredLevel Int
  description   String?
}

// ─── V1: PROGRESSION EVENTS ─────────────────────────────────────

model ProgressionEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String   // XP_AWARDED, SKILL_XP_AWARDED, LEVEL_UP, SKILL_LEVEL_UP, MISSION_COMPLETED
  amount    Int?
  source    String   // FLAG_SOLVED, LAB_COMPLETED, LESSON_COMPLETED, QUIZ_PASSED, MISSION_REWARD
  sourceId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type])
}

// ─── V2: PERSONALIZATION ────────────────────────────────────────

model UserPreference {
  id       String @id @default(uuid())
  userId   String @unique
  interests String[] @default([]) // ["security", "devops", "networking"]
  weakSkills String[] @default([]) // Skills the user struggles with
  preferredDifficulty String @default("MEDIUM")
  notificationsEnabled Boolean @default(true)
  weeklyDigestEnabled  Boolean @default(true)
  displayMode  String @default("PROGRESSION") // PROFESSIONAL, PROGRESSION, COMPETITIVE

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── V2: LEADERBOARD SNAPSHOTS ──────────────────────────────────

model LeaderboardSnapshot {
  id        String   @id @default(uuid())
  seasonId  String?
  period    String   // WEEKLY, MONTHLY, SEASONAL
  snapshotAt DateTime @default(now())
  data      Json     // Array of { userId, xp, rank, division, position }

  season Season? @relation(fields: [seasonId], references: [id])

  @@index([period, snapshotAt])
}

// ─── V3: BATTLE PASS ──────────────────────────────────────────────

model BattlePass {
  id         String   @id @default(uuid())
  seasonId   String   @unique
  title      String
  totalTiers Int      @default(50)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id])
  tiers  BattlePassTier[]
}

model BattlePassTier {
  id          String   @id @default(uuid())
  battlePassId String
  tierNumber  Int
  title       String
  description String?
  xpRequired  Int
  rewards     Json     // [{ type: 'BADGE', id, name }, { type: 'TITLE', title: 'X' }]
  isPremium   Boolean  @default(false)
  createdAt   DateTime @default(now())

  battlePass BattlePass    @relation(fields: [battlePassId], references: [id])
  progress   BattlePassProgress[]

  @@unique([battlePassId, tierNumber])
  @@index([battlePassId])
}

model BattlePassProgress {
  id         String    @id @default(uuid())
  userId     String
  tierId     String
  currentXp  Int       @default(0)
  unlocked   Boolean   @default(false)
  unlockedAt DateTime?
  createdAt  DateTime  @default(now())

  tier BattlePassTier   @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([userId, tierId])
  @@index([userId])
  @@index([tierId])
}

// ─── V3: BOSS MISSIONS ──────────────────────────────────────────

model BossMission {
  id              String   @id @default(uuid())
  seasonId        String?
  title           String
  description     String
  difficulty      String   // EASY, MEDIUM, HARD, BOSS
  maxAttempts     Int      @default(3)
  xpReward        Int
  ratingReward    Int      @default(200) // domain rating awarded on completion
  badgeRewardId   String?
  prerequisiteLabIds Json  @default("[]") // lab IDs required before attempting
  requiredDomains Json     @default("[]") // [{ domainId, minRating }], cross-domain requirements
  domainId        String?  // Primary domain for this boss
  theme           String?  // Seasonal theme tag (e.g. "zero-day", "ransomware")
  labId           String?  // The lab the boss mission runs against
  isActive        Boolean  @default(true)
  startsAt        DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  season   Season?              @relation(fields: [seasonId], references: [id])
  attempts BossMissionAttempt[]

  @@index([seasonId, isActive])
  @@index([startsAt, expiresAt])
}

model BossMissionAttempt {
  id           String   @id @default(uuid())
  userId       String
  bossId       String
  score        Int      @default(0)
  maxScore     Int      @default(100)
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  feedback     Json?
  createdAt    DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  boss BossMission  @relation(fields: [bossId], references: [id], onDelete: Cascade)

  @@unique([userId, bossId])
  @@index([userId])
  @@index([bossId])
}

// ─── V3: CROSS-DOMAIN MISSIONS ─────────────────────────────────

model CrossDomainMission {
  id              String   @id @default(uuid())
  title           String
  description     String
  requiredDomains Json     // [{ domainId: 'xxx', minSkillXp: 500 }, ...]
  xpReward        Int
  badgeRewardId   String?
  isActive        Boolean  @default(true)
  startsAt        DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  userProgress CrossDomainProgress[]

  @@index([isActive, startsAt, expiresAt])
}

model CrossDomainProgress {
  id        String   @id @default(uuid())
  userId    String
  missionId String
  progress  Json     // { domainId: currentXp, ... }
  completed Boolean  @default(false)
  completedAt DateTime?
  createdAt DateTime @default(now())

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission CrossDomainMission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
  @@index([userId])
}

// ─── V3: GLOBAL EVENTS ─────────────────────────────────────────

model GlobalEvent {
  id          String   @id @default(uuid())
  seasonId    String?
  title       String
  description String
  type        String   // COMMUNITY_XP, TEAM_COMPETITION, SPEEDRUN, COLLABORATIVE
  targetXp    Int?     // Target XP for community events
  targetCount Int?     // Target count for collaborative events
  xpReward    Int      @default(0)
  metadata    Json?    // { labId, speedrunTargetMinutes, ... }
  startsAt    DateTime
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  season       Season?                @relation(fields: [seasonId], references: [id])
  participants GlobalEventParticipant[]

  @@index([seasonId, isActive])
  @@index([startsAt, expiresAt])
}

model GlobalEventParticipant {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  progress  Int      @default(0)
  completed Boolean  @default(false)
  completedAt DateTime?
  rewardClaimed Boolean @default(false)
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  event GlobalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// ─── V3: ADVANCED RANKING ───────────────────────────────────────

model RankingTier {
  id          String @id @default(uuid())
  name        String @unique // BRONZE, SILVER, GOLD, PLATINUM, DIAMOND, MASTER, GRANDMASTER
  displayName String
  icon        String?
  minXp       Int
  maxXp       Int
  kFactor     Float  @default(32.0)  // ELO sensitivity
  decayRate   Float  @default(0.0)   // Daily XP decay percentage
  order       Int    @default(0)
  isActive    Boolean @default(true)

  @@index([minXp, maxXp])
  @@index([order])
}

model RankingHistory {
  id        String   @id @default(uuid())
  userId    String
  fromTier  String
  toTier    String
  reason    String   // XP_REACH, DECAY, SEASON_RESET
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model WinStreak {
  id             String   @id @default(uuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastWinDate    DateTime?
  streakMultiplier Float @default(1.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model DomainRank {
  id                  String   @id @default(uuid())
  userId              String
  domainId            String
  seasonId            String
  rating              Int      @default(1000)
  division            String   @default("BRONZE")
  divisionTier        Int      @default(1)
  gamesPlayed         Int      @default(0)
  wins                Int      @default(0)
  losses              Int      @default(0)
  draws               Int      @default(0)
  isProvisional       Boolean  @default(true)
  placementMatchesLeft Int     @default(5)
  careerHighRating    Int      @default(1000)
  careerHighDivision  String   @default("BRONZE")
  careerHighTier      Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  domain   SkillDomain @relation(fields: [domainId], references: [id])
  season   Season      @relation(fields: [seasonId], references: [id])

  @@unique([userId, domainId, seasonId])
  @@index([domainId, seasonId, rating(sort: Desc)])
  @@index([userId, seasonId])
  @@index([rating(sort: Desc)])
}

model SeasonRankSnapshot {
  id              String   @id @default(uuid())
  userId          String
  domainId        String
  seasonId        String
  seasonNumber    Int
  finalRating     Int
  finalDivision   String
  finalTier       Int
  gamesPlayed     Int
  wins            Int
  losses          Int
  placementRating Int?
  createdAt       DateTime @default(now())

  user   User        @relation(fields: [userId], references: [id])
  season Season      @relation(fields: [seasonId], references: [id])

  @@unique([userId, domainId, seasonId])
  @@index([userId, seasonNumber])
  @@index([domainId, seasonId, finalRating(sort: Desc)])
}

model GlobalRankSnapshot {
  id             String   @id @default(uuid())
  userId         String
  seasonId       String
  seasonNumber   Int
  globalRating   Int
  globalDivision String
  globalTier     Int
  domainCount    Int
  gamesPlayed    Int
  wins           Int
  losses         Int
  winRate        Int
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@unique([userId, seasonId])
  @@index([userId, seasonNumber])
}

model PlacementMatch {
  id             String   @id @default(uuid())
  userId         String
  domainId       String
  seasonId       String
  activityType   String
  activityId     String?
  difficulty     String
  performance    Float
  quality        Float
  timeEfficiency Float
  independence   Float
  ratingDelta    Int
  ratingBefore   Int
  ratingAfter    Int
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@index([userId, domainId, seasonId])
  @@index([seasonId, domainId])
}

model DomainRatingEvent {
  id             String   @id @default(uuid())
  userId         String
  domainId       String
  seasonId       String
  activityType   String
  activityId     String?
  difficulty     String
  performance    Float
  quality        Float
  timeEfficiency Float
  independence   Float
  ratingDelta    Int
  ratingBefore   Int
  ratingAfter    Int
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@index([userId, domainId, seasonId])
  @@index([seasonId, createdAt(sort: Desc)])
}

// ─── V5: LEARNING OUTCOMES & COMPETENCY ─────────────────────────

model LearningOutcome {
  id          String   @id @default(uuid())
  code        String   // LO1, LO2, etc.
  title       String
  description String
  domainId    String
  weight      Float    @default(1.0) // importance weight for competency calc
  createdAt   DateTime @default(now())

  domain       SkillDomain          @relation(fields: [domainId], references: [id])
  skillOutcomes SkillOutcome[]
  labOutcomes  LabOutcome[]
  assessments  AssessmentOutcome[]
  evidence     OutcomeEvidence[]
  moduleOutcomes ModuleOutcome[]

  @@unique([domainId, code])
  @@index([domainId])
}

model SkillOutcome {
  id              String @id @default(uuid())
  skillId         String
  learningOutcomeId String
  weight          Float  @default(1.0)

  skill   Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)
  outcome LearningOutcome @relation(fields: [learningOutcomeId], references: [id], onDelete: Cascade)

  @@unique([skillId, learningOutcomeId])
  @@index([skillId])
  @@index([learningOutcomeId])
}

model LabOutcome {
  id              String @id @default(uuid())
  labId           String
  learningOutcomeId String
  weight          Float  @default(1.0)

  lab    Lab             @relation(fields: [labId], references: [id], onDelete: Cascade)
  outcome LearningOutcome @relation(fields: [learningOutcomeId], references: [id], onDelete: Cascade)

  @@unique([labId, learningOutcomeId])
  @@index([labId])
  @@index([learningOutcomeId])
}

model OutcomeEvidence {
  id                String   @id @default(uuid())
  userId            String
  learningOutcomeId String
  activityType      String   // LAB_COMPLETED, FLAG_SOLVED, ASSESSMENT_PASSED, BOSS_COMPLETED
  activityId        String
  score             Float    // 0-100, how well the outcome was demonstrated
  metadata          Json?
  demonstratedAt    DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id])
  outcome LearningOutcome @relation(fields: [learningOutcomeId], references: [id])

  @@index([userId, learningOutcomeId])
  @@index([userId, activityType])
  @@index([learningOutcomeId])
  @@index([demonstratedAt])
}

// ─── V5: CURRICULUM & COHORTS ──────────────────────────────────

model Curriculum {
  id          String   @id @default(uuid())
  name        String
  description String
  institution String
  degree      String   // BSc, MSc, Diploma
  year        Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  modules CurriculumModule[]
  cohorts Cohort[]
}

model CurriculumModule {
  id             String   @id @default(uuid())
  curriculumId   String
  name           String
  code           String   // CS301, NET201
  credits        Int
  theoryHours    Int      @default(0)
  practicalHours Int      @default(0)
  createdAt      DateTime @default(now())

  curriculum Curriculum         @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  outcomes   ModuleOutcome[]
  labs       ModuleLab[]
  courses    ModuleCourse[]

  @@index([curriculumId])
}

model ModuleOutcome {
  id                 String @id @default(uuid())
  moduleId           String
  learningOutcomeId  String
  weight             Float  @default(1.0)

  module  CurriculumModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  outcome LearningOutcome  @relation(fields: [learningOutcomeId], references: [id], onDelete: Cascade)

  @@unique([moduleId, learningOutcomeId])
}

model ModuleLab {
  id       String @id @default(uuid())
  moduleId String
  labId    String

  module CurriculumModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lab    Lab              @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([moduleId, labId])
}

model ModuleCourse {
  id       String @id @default(uuid())
  moduleId String
  courseId String

  module CurriculumModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  course Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([moduleId, courseId])
  @@index([moduleId])
  @@index([courseId])
}

model Cohort {
  id           String   @id @default(uuid())
  curriculumId String
  name         String
  semester     String?
  year         Int
  maxStudents  Int      @default(50)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  curriculum Curriculum              @relation(fields: [curriculumId], references: [id])
  members    CohortMember[]
  courseAssignments CohortCourseAssignment[]
  gradeCategories  GradeCategory[]

  @@index([curriculumId])
}

model CohortMember {
  id       String @id @default(uuid())
  cohortId String
  userId   String
  role     String @default("STUDENT") // STUDENT, TA, PROFESSOR
  joinedAt DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
}

model CohortCourseAssignment {
  id           String   @id @default(uuid())
  cohortId     String
  courseId      String
  weight       Float    @default(1.0)
  isRequired   Boolean  @default(true)
  assignedAt   DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cohortId, courseId])
  @@index([cohortId])
  @@index([courseId])
}

model GradeCategory {
  id          String   @id @default(uuid())
  cohortId    String
  name        String
  weight      Float
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  cohort  Cohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  entries GradeEntry[]

  @@index([cohortId])
}

model GradeEntry {
  id           String   @id @default(uuid())
  categoryId   String
  userId       String
  title        String
  score        Float
  maxScore     Float    @default(100)
  weight       Float    @default(1.0)
  comment      String?
  gradedById   String?
  gradedAt     DateTime?
  createdAt    DateTime @default(now())

  category GradeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([categoryId, userId, title])
  @@index([categoryId])
  @@index([userId])
}

model StudentGPA {
  id              String   @id @default(uuid())
  userId          String   @unique
  cumulativeGPA   Float    @default(0)
  totalCredits    Int      @default(0)
  lastCalculatedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── V5: PRACTICAL ASSESSMENTS ─────────────────────────────────

model PracticalAssessment {
  id            String   @id @default(uuid())
  title         String
  description   String
  domainId      String?
  timeLimit     Int      // minutes
  maxScore      Int      @default(100)
  passingScore  Int      @default(70) // minimum % to pass
  maxAttempts   Int      @default(3) // max attempts per student (0 = unlimited)
  isProctored   Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  domain   SkillDomain?        @relation(fields: [domainId], references: [id])
  outcomes AssessmentOutcome[]
  attempts StudentAssessment[]
  scenarios AssessmentScenario[]

  @@index([domainId])
}

model AssessmentScenario {
  id             String   @id @default(uuid())
  assessmentId   String
  title          String
  description    String
  order          Int      @default(0)
  maxScore       Int      @default(100)
  expectedSteps  Json?    // expected methodology
  expectedState  Json?    // expected final state
  hints          Json?

  assessment PracticalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model AssessmentOutcome {
  id              String @id @default(uuid())
  assessmentId    String
  learningOutcomeId String
  weight          Float  @default(1.0)

  assessment PracticalAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  outcome    LearningOutcome     @relation(fields: [learningOutcomeId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, learningOutcomeId])
}

model StudentAssessment {
  id           String   @id @default(uuid())
  userId       String
  assessmentId String
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  score        Int?
  maxScore     Int      @default(100)
  breakdown    Json?    // { correctness, methodology, time, independence, finalState }
  feedback     Json?
  status       String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, EXPIRED

  user       User                 @relation(fields: [userId], references: [id])
  assessment PracticalAssessment  @relation(fields: [assessmentId], references: [id])

  @@unique([userId, assessmentId])
  @@index([userId])
  @@index([assessmentId])
}

// ─── V5: CERTIFICATIONS ────────────────────────────────────────

model Certification {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique // XCA, XCP, XCE
  description String
  requirements Json    // { domains: [{ domainId, minMastery, minLabs }], assessments: N, crossDomain: bool }
  xpRequired  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  awards CertificationAward[]
}

model CertificationAward {
  id              String   @id @default(uuid())
  userId          String
  certificationId String
  awardedAt       DateTime @default(now())
  expiresAt       DateTime?
  credentialId    String   @unique // public verification ID
  evidenceSummary Json     // snapshot of competency at award time

  user          User          @relation(fields: [userId], references: [id])
  certification Certification @relation(fields: [certificationId], references: [id])
  renewals      CertificationRenewal[]

  @@unique([userId, certificationId])
  @@index([userId])
  @@index([credentialId])
}

model CertificationRenewal {
  id              String   @id @default(uuid())
  awardId         String
  renewedAt       DateTime @default(now())
  expiresAt       DateTime?
  evidenceSummary Json     // snapshot at renewal time
  method          String   // AUTO, MANUAL, ASSESSMENT

  award CertificationAward @relation(fields: [awardId], references: [id], onDelete: Cascade)

  @@index([awardId])
}

model ProfessionalRecord {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shareToken String? @unique // public shareable link token
  data      Json     // full competency snapshot

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([shareToken])
}

// ─── PHASE 5: COMPETITION VALIDATION ────────────────────────────

model MetricEvent {
  id        String   @id @default(uuid())
  userId    String?
  displayMode String? // PROFESSIONAL, PROGRESSION, COMPETITIVE
  type      String   // SESSION_START, LAB_COMPLETED, MISSION_COMPLETED, RETURN_VISIT, FEATURE_USED
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([displayMode, type])
  @@index([createdAt])
  @@index([userId])
}

// ─── AI CONTENT ENGINE: LAB ANALYTICS ─────────────────────────────

model LabAnalytics {
  id              String   @id @default(uuid())
  labId           String
  domainName      String?

  // Aggregate metrics (nightly batch)
  totalAttempts   Int      @default(0)
  completions     Int      @default(0)
  completionRate  Float    @default(0)
  avgTimeMinutes  Float    @default(0)
  medianTimeMinutes Float?
  totalSubmissions Int     @default(0)
  correctSubmissions Int  @default(0)
  failureRate     Float    @default(0)
  hintUsageRate   Float    @default(0)

  // Difficulty calibration
  difficultyELO   Float?   // computed difficulty based on actual performance
  tooEasy         Boolean  @default(false)  // completionRate > 85%
  tooHard         Boolean  @default(false)  // completionRate < 15%

  // Step-level analytics (JSON)
  stepAnalytics   Json?    // [{step, attempts, completions, avgTime, failureRate}]

  // Trend data
  weeklyCompletions Json?  // [{week, count}]
  weeklyAttempts    Json?  // [{week, count}]

  lastUpdated     DateTime @default(now())
  createdAt       DateTime @default(now())

  lab   Lab  @relation(fields: [labId], references: [id], onDelete: Cascade)

  @@unique([labId])
  @@index([labId])
  @@index([completionRate])
  @@index([failureRate])
}

model TutoringInteraction {
  id          String   @id @default(uuid())
  userId      String
  type        String   // chat, lab_assist, hint, socratic
  message     String
  response    String
  method      String   // socratic, direct, hint, encouragement
  labId       String?
  conceptTags String[] @default([])
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([labId])
  @@index([createdAt])
}
